# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla commit edilmez (bkz. .gitignore).

# --- Veritabani (compose.yaml varsayilanlariyla eslesir) ---
DB_URL=jdbc:postgresql://localhost:5433/belediye_asistan
DB_USER=postgres
DB_PASSWORD=postgres

# --- Chat modeli (Faz 1'den itibaren zorunlu) ---
# Gelistirmede ucretsiz katmani olan Groq kullaniliyor (kredi karti gerekmiyor):
# https://console.groq.com/keys adresinden anahtar alin.
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_API_KEY=gsk_...
AI_CHAT_MODEL=openai/gpt-oss-20b

# Gercek OpenAI'a gecmek isterseniz:
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-...
# AI_CHAT_MODEL=gpt-4o-mini

# --- Embedding modeli (Faz 2'de RAG icin gerekli, Groq desteklemiyor) ---
AI_EMBEDDING_MODEL=text-embedding-3-small
