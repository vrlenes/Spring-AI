# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla commit edilmez (bkz. .gitignore).

# --- Veritabani (compose.yaml varsayilanlariyla eslesir) ---
DB_URL=jdbc:postgresql://localhost:5433/belediye_asistan
DB_USER=postgres
DB_PASSWORD=postgres

# --- Ollama (yerel, ucretsiz - hem chat hem embedding) ---
# Kurulum: https://ollama.com/download, sonra:
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBEDDING_MODEL=bge-m3
