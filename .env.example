# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# .env asla commit edilmez (bkz. .gitignore).

# --- Veritabani (compose.yaml varsayilanlariyla eslesir) ---
DB_URL=jdbc:postgresql://localhost:5433/belediye_asistan
DB_USER=postgres
DB_PASSWORD=postgres

# --- OpenAI (Faz 1'den itibaren zorunlu) ---
OPENAI_API_KEY=sk-...
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
